{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "git": {
        "deploymentEnabled": {
            "main": false
        }
    },
    "installCommand": "cd frontend && npm ci --ignore-scripts",
    "buildCommand": "cd frontend && npm run build:web",
    "env": {
        "REMOTE_JOIN_ENABLED": "false",
        "LIVE_PORTRAIT_ENABLED": "false",
        "GOOGLE_AUTH_ENABLED": "false",
        "AUTHENTICATED_UPLOAD_ENABLED": "false",
        "GENERATION_ENABLED": "false",
        "CREDIT_PACK_CHECKOUT_ENABLED": "false",
        "SUBSCRIPTION_BILLING_ENABLED": "false",
        "PRIVATE_DOWNLOAD_ENABLED": "false",
        "PARTNER_INVITE_ENABLED": "false",
        "QA_REQUIRE_VISION": "true",
        "QA_FAIL_ON_VISION_ERROR": "true"
    },
    "outputDirectory": "frontend/dist/build/h5",
    "functions": {
        "api/index.py": {
            "includeFiles": "backend/app/core/certs/prod-ca-2021.crt",
            "maxDuration": 300
        }
    },
    "redirects": [
        {
            "source": "/create",
            "destination": "/pages/create/index",
            "permanent": false
        },
        {
            "source": "/studio",
            "destination": "/pages/create/index",
            "permanent": false
        }
    ],
    "rewrites": [
        {
            "source": "/health",
            "destination": "/api/index.py"
        },
        {
            "source": "/health/:path*",
            "destination": "/api/index.py"
        },
        {
            "source": "/version",
            "destination": "/api/index.py"
        },
        {
            "source": "/api/v1/users/",
            "destination": "/api/index.py"
        },
        {
            "source": "/api/:path*",
            "destination": "/api/index.py"
        },
        {
            "source": "/api/v1/orders/",
            "destination": "/api/index.py"
        },
        {
            "source": "/api/v1/orders/:path*",
            "destination": "/api/index.py"
        },
        {
            "source": "/static/styles/:path*",
            "destination": "/api/index.py"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Content-Security-Policy",
                    "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; connect-src 'self' https://*.supabase.co; img-src 'self' data: blob:; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; upgrade-insecure-requests"
                },
                {
                    "key": "Strict-Transport-Security",
                    "value": "max-age=31536000; includeSubDomains"
                },
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                },
                {
                    "key": "Permissions-Policy",
                    "value": "camera=(), microphone=(), geolocation=(), payment=()"
                }
            ]
        },
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/static/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=86400"
                }
            ]
        }
    ]
}
