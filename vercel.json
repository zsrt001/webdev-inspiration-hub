{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "git": {
        "deploymentEnabled": {
            "main": false
        }
    },
    "installCommand": "cd frontend && npm ci --ignore-scripts",
    "buildCommand": "cd frontend && npm run build:web",
    "env": {
        "REMOTE_JOIN_ENABLED": "false",
        "LIVE_PORTRAIT_ENABLED": "false",
        "GOOGLE_AUTH_ENABLED": "false",
        "AUTHENTICATED_UPLOAD_ENABLED": "false",
        "GENERATION_ENABLED": "false",
        "CREDIT_PACK_CHECKOUT_ENABLED": "false",
        "SUBSCRIPTION_BILLING_ENABLED": "false",
        "PRIVATE_DOWNLOAD_ENABLED": "false",
        "PARTNER_INVITE_ENABLED": "false",
        "QA_REQUIRE_VISION": "true",
        "QA_FAIL_ON_VISION_ERROR": "true"
    },
    "outputDirectory": "frontend/dist/build/h5",
    "functions": {
        "api/index.py": {
            "maxDuration": 300
        }
    },
    "crons": [
        {
            "path": "/api/v1/ops/check_alerts",
            "schedule": "0 20 * * *"
        }
    ],
    "redirects": [
        {
            "source": "/create",
            "destination": "/pages/create/index",
            "permanent": false
        },
        {
            "source": "/studio",
            "destination": "/pages/create/index",
            "permanent": false
        }
    ],
    "rewrites": [
        {
            "source": "/health",
            "destination": "/api/index.py"
        },
        {
            "source": "/health/:path*",
            "destination": "/api/index.py"
        },
        {
            "source": "/api/:path*",
            "destination": "/api/index.py"
        },
        {
            "source": "/api/v1/orders/",
            "destination": "/api/index.py"
        },
        {
            "source": "/api/v1/orders/:path*",
            "destination": "/api/index.py"
        },
        {
            "source": "/static/styles/:path*",
            "destination": "/api/index.py"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/static/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=86400"
                }
            ]
        },
        {
            "source": "/api/(.*)",
            "headers": [
                {
                    "key": "Access-Control-Allow-Origin",
                    "value": "https://www.vowpic.com"
                },
                {
                    "key": "Access-Control-Allow-Methods",
                    "value": "GET, POST, PUT, DELETE, OPTIONS"
                },
                {
                    "key": "Access-Control-Allow-Headers",
                    "value": "Content-Type, Authorization, X-Device-Id, X-Visitor-Id, X-Client-Fingerprint"
                }
            ]
        }
    ]
}
