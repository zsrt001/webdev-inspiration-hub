{
    "name": "AI婚纱照",
    "appid": "__UNI__XXXXXXX",
    "description": "AI智能婚纱照生成",
    "versionName": "1.0.0",
    "versionCode": "100",
    "transformPx": false,
    "h5": {
        "title": "AI Wedding Photo",
        "router": {
            "mode": "history",
            "base": "/"
        },
        "devServer": {
            "https": false,
            "port": 3000,
            "proxy": {
                "/api": {
                    "target": "http://localhost:8001",
                    "changeOrigin": true
                },
                "/static/styles": {
                    "target": "http://localhost:8001",
                    "changeOrigin": true
                }
            }
        },
        "optimization": {
            "prefetch": true,
            "preload": true
        },
        "template": "template.h5.html"
    },
    "mp-weixin": {
        "appid": "",
        "setting": {
            "urlCheck": false,
            "es6": true,
            "minified": true,
            "postcss": true
        },
        "usingComponents": true,
        "optimization": {
            "subPackages": true
        },
        "permission": {
            "scope.userLocation": {
                "desc": "用于获取您的位置信息"
            }
        }
    },
    "networkTimeout": {
        "request": 30000,
        "uploadFile": 60000
    }
}
