{
    "name": "VowPic",
    "appid": "__UNI__XXXXXXX",
    "description": "VowPic overseas AI wedding portrait Web SaaS",
    "versionName": "1.0.0",
    "versionCode": "100",
    "transformPx": false,
    "h5": {
        "title": "VowPic",
        "router": {
            "mode": "history",
            "base": "/"
        },
        "devServer": {
            "https": false,
            "port": 3000,
            "proxy": {
                "/api": {
                    "target": "http://localhost:8001",
                    "changeOrigin": true
                },
                "/static/styles": {
                    "target": "http://localhost:8001",
                    "changeOrigin": true
                }
            }
        },
        "optimization": {
            "prefetch": true,
            "preload": true
        },
        "template": "template.h5.html"
    },
    "networkTimeout": {
        "request": 30000,
        "uploadFile": 60000
    }
}
