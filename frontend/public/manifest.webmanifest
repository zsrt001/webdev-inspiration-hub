{
  "id": "/",
  "name": "VowPic",
  "short_name": "VowPic",
  "description": "VowPic creates AI wedding portraits for private preview and HD delivery.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "portrait-primary",
  "background_color": "#f7f8fa",
  "theme_color": "#17191f",
  "categories": ["photo", "lifestyle", "productivity"],
  "icons": [
    {
      "src": "/icons/pwa-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Create",
      "short_name": "Create",
      "description": "Start a new AI wedding portrait.",
      "url": "/pages/create/index?source=pwa_shortcut",
      "icons": [{ "src": "/icons/pwa-icon.svg", "sizes": "any", "type": "image/svg+xml" }]
    },
    {
      "name": "Orders",
      "short_name": "Orders",
      "description": "View generation history.",
      "url": "/pages/orders/orders?source=pwa_shortcut",
      "icons": [{ "src": "/icons/pwa-icon.svg", "sizes": "any", "type": "image/svg+xml" }]
    }
  ]
}
