# Application
APP_NAME=AI Wedding Photo API
DEBUG=true
AUTO_CREATE_TABLES=true
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (Supabase/Neon compatible URL)
# Supabase example: paste the direct/session pooler URL from Project Settings > Database.
# The backend normalizes postgresql:// to postgresql+asyncpg:// and maps sslmode=require for asyncpg.
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase Auth
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# Redis
REDIS_URL=redis://localhost:6379/0
TASK_EXECUTION_MODE=inline

# AWS S3 Storage (for Vercel deployment)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=ai-wedding-photos
AWS_REGION=us-east-1
AWS_S3_ENDPOINT=  # Leave empty for AWS, set for MinIO (e.g., http://localhost:9000)
STORAGE_PROVIDER=s3  # s3 | vercel

# Vercel Blob Storage
BLOB_READ_WRITE_TOKEN=

# Replicate API (legacy compatibility, not used by commercial main flow)
REPLICATE_API_TOKEN=

# OpenRouter (Vision Gatekeeper + QA)
OPENROUTER_API_KEY=
GATEKEEPER_ALLOW_WITHOUT_PILLOW=false
QA_ALLOW_WITHOUT_PILLOW=false
QA_REQUIRE_VISION=false
WEBHOOK_BASE_URL=http://localhost:8001
FRONTEND_BASE_URL=http://localhost:3000
GENERATION_ENGINE=wenwen  # comfyui | wenwen | evolink

# Hosted checkout / subscriptions
PAYMENT_PROVIDER=creem
SUPPORT_CONTACT_EMAIL=
SUPPORT_CONTACT_URL=
REFUND_POLICY_URL=/pages/legal/refund
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_PRODUCT_PACK_50=
CREEM_PRODUCT_PACK_120=
CREEM_PRODUCT_PACK_300=
SUBSCRIPTION_BILLING_ENABLED=false
CREEM_SUBSCRIPTION_STARTER_PRODUCT_ID=
CREEM_SUBSCRIPTION_CREATOR_PRODUCT_ID=
CREEM_SUBSCRIPTION_STUDIO_PRODUCT_ID=

# ComfyUI
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW_PATH=workflows/comfyui_base.json
COMFYUI_INPAINT_WORKFLOW_PATH=workflows/comfyui_couple_inpaint.json
COMFYUI_LIVE_PORTRAIT_WORKFLOW_PATH=workflows/comfyui_live_portrait.json
COMFYUI_NODE_MAP={"prompt":{"id":"2","key":"text"},"negative_prompt":{"id":"3","key":"text"},"scene_image_url":{"id":"12","key":"image","upload":true,"type":"input","allow_empty":true},"clothing_image_url":{"id":"13","key":"image","upload":true,"type":"input","allow_empty":true},"face_image_url":{"id":"14","key":"image","upload":true,"type":"input","allow_empty":true},"face_image_url_2":{"id":"34","key":"image","upload":true,"type":"input","allow_empty":true},"pose_image_url":{"id":"22","key":"image","upload":true,"type":"input","allow_empty":true},"depth_image_url":{"id":"23","key":"image","upload":true,"type":"input","allow_empty":true},"normal_image_url":{"id":"24","key":"image","upload":true,"type":"input","allow_empty":true},"scene_ip_weight":{"id":"19","key":"weight"},"clothing_ip_weight":{"id":"20","key":"weight"},"face_ip_weight":{"id":"21","key":"weight"},"face2_ip_weight":{"id":"35","key":"weight"},"pose_cn_weight":{"id":"28","key":"strength"},"depth_cn_weight":{"id":"29","key":"strength"},"normal_cn_weight":{"id":"30","key":"strength"},"pose_cn_start":{"id":"28","key":"start_percent"},"pose_cn_end":{"id":"28","key":"end_percent"},"depth_cn_start":{"id":"29","key":"start_percent"},"depth_cn_end":{"id":"29","key":"end_percent"},"normal_cn_start":{"id":"30","key":"start_percent"},"normal_cn_end":{"id":"30","key":"end_percent"}}
COMFYUI_LIVE_PORTRAIT_NODE_MAP={"image_url":{"id":"1","key":"image","upload":true,"type":"input"},"seconds":{"id":"2","key":"seconds"}}
COMFYUI_POLL_INTERVAL=1.5
COMFYUI_POLL_TIMEOUT=300
COMFYUI_MAX_RETRIES=1
COMFYUI_REQUIRE_STORAGE_DELIVERY=true

# Evolink
EVOLINK_API_KEY=
EVOLINK_API_BASE_URL=https://api.evolink.ai
EVOLINK_IMAGE_MODEL=gemini-3-pro-image-preview
EVOLINK_IMAGE_FALLBACK_MODELS=
EVOLINK_IMAGE_QUALITY=2K
EVOLINK_IMAGE_SIZE=3:4
EVOLINK_POLL_INTERVAL=5.0
EVOLINK_POLL_TIMEOUT=720
EVOLINK_MAX_RETRIES=2
CLEANUP_SOURCE_IMAGES_ON_COMPLETE=false
CLEANUP_CRON_TOKEN=
CRON_SECRET=

# Observability
SENTRY_DSN=

# Alert push (Slack incoming webhook / Feishu bot / DingTalk bot URL)
OPS_ALERT_WEBHOOK_URL=

# Email notifications (Resend - https://resend.com)
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_FROM_NAME=AI Wedding Studio

# Vercel Edge Rate Limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Live Portrait (V1.2 add-on)
REMOTE_JOIN_ENABLED=true
LIVE_PORTRAIT_ENABLED=false
ALLOW_MEMORY_FALLBACK=false

# Security
SECRET_KEY=change-me-to-a-secure-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ADMIN_USER_IDS=
ADMIN_OPENIDS=
ADMIN_EMAILS=
ADMIN_TOKEN=
PHONE_CRYPTO_KEY=
RATE_LIMIT_ENABLED=false
RATE_LIMIT_DEFAULT_REQUESTS=240
RATE_LIMIT_DEFAULT_WINDOW_SECONDS=60
RATE_LIMIT_SENSITIVE_REQUESTS=40
RATE_LIMIT_SENSITIVE_WINDOW_SECONDS=60
NEW_ACCOUNT_IP_LIMIT_PER_HOUR=8
NEW_ACCOUNT_DEVICE_LIMIT_PER_HOUR=3

# Trial / free preview commercial guardrails
TRIAL_WELCOME_CREDITS=6
TRIAL_DAILY_GENERATION_LIMIT=3
TRIAL_PREVIEW_MAX_WIDTH=900
TRIAL_PREVIEW_MAX_HEIGHT=1125
TRIAL_WATERMARK_TEXT=AI WEDDING STUDIO PREVIEW

# Post-processing delivery layer
POSTPROCESS_ENABLED=true
POSTPROCESS_UPSCALE_FACTOR=2
POSTPROCESS_MAX_LONG_EDGE=2400
POSTPROCESS_JPEG_QUALITY=92
POSTPROCESS_VARIANTS=2x3,3x4,9x16
