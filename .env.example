# Application
APP_NAME=AI Wedding Photo API
DEBUG=true
AUTO_CREATE_TABLES=false
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RUNTIME_ENVIRONMENT=development
# VERCEL_DEPLOYMENT_ID is a Vercel System Environment Variable. Do not create a project override.
RUNTIME_BUNDLE_ID=
WORKER_IMAGE_DIGEST=
ACCEPTANCE_IDENTITY_HMAC_KEY=

# Database (Supabase/Neon compatible URL)
# Supabase example: paste the direct/session pooler URL from Project Settings > Database.
# The backend normalizes postgresql:// to postgresql+asyncpg:// and maps sslmode=require for asyncpg.
DATABASE_URL=postgresql://vowpic_app_runtime.your-project-ref:runtime-password@aws-0-your-region.pooler.supabase.com:5432/postgres?sslmode=require
# Separate NOBYPASSRLS login granted only the vowpic_control_writer group.
CONTROL_PLANE_DATABASE_URL=postgresql://vowpic_control_login.your-project-ref:writer-password@aws-0-your-region.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase Auth
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
# Retired bootstrap variables stay false; PostgreSQL ops_feature_flags is authoritative.
GOOGLE_AUTH_ENABLED=false
AUTHENTICATED_UPLOAD_ENABLED=false
GENERATION_ENABLED=false
CREDIT_PACK_CHECKOUT_ENABLED=false
PRIVATE_DOWNLOAD_ENABLED=false
PARTNER_INVITE_ENABLED=false

# Redis
REDIS_URL=redis://localhost:6379/0
TASK_EXECUTION_MODE=inline

# AWS S3 Storage (for Vercel deployment)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=ai-wedding-photos
AWS_REGION=us-east-1
AWS_S3_ENDPOINT=  # Leave empty for AWS, set for MinIO (e.g., http://localhost:9000)
STORAGE_PROVIDER=s3  # s3 | vercel

# Vercel Blob Storage
BLOB_READ_WRITE_TOKEN=
# Hard media ceilings may only be lowered. Production Blob must be a separately provisioned Private store.
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_FILES=5
UPLOAD_MAX_PIXELS=40000000
UPLOAD_REQUESTS_PER_HOUR=20
UPLOAD_BYTES_PER_DAY=209715200
UPLOAD_MAX_CONCURRENT=2
UPLOAD_INTENT_TTL_SECONDS=900
PROVIDER_ASSET_GRANT_TTL_SECONDS=600
PROVIDER_ASSET_GRANT_MAX_READS=3
EXTERNAL_FETCH_MAX_REDIRECTS=2
EXTERNAL_FETCH_CONNECT_TIMEOUT_SECONDS=5
EXTERNAL_FETCH_TOTAL_TIMEOUT_SECONDS=30
EXTERNAL_FETCH_MAX_BYTES=10485760

# Replicate API (legacy compatibility, not used by commercial main flow)
REPLICATE_API_TOKEN=

# OpenRouter (Vision Gatekeeper + QA)
OPENROUTER_API_KEY=
GATEKEEPER_ALLOW_WITHOUT_PILLOW=false
QA_ALLOW_WITHOUT_PILLOW=false
QA_REQUIRE_VISION=true
QA_FAIL_ON_VISION_ERROR=true
QA_REQUIRE_IDENTITY_VISION=true
QA_REQUIRE_IDENTITY_EMBEDDING=true
QA_IDENTITY_SIMILARITY_SINGLE_THRESHOLD=0.55
QA_IDENTITY_SIMILARITY_COUPLE_THRESHOLD=0.50
QA_IDENTITY_SIMILARITY_MARGIN_THRESHOLD=0.08
QA_IDENTITY_GENERATED_FACE_SIMILARITY_MAX=0.82
QA_IDENTITY_EMBEDDING_MODEL_NAME=buffalo_l
QA_IDENTITY_EMBEDDING_DET_SIZE=640
QA_IDENTITY_EMBEDDING_CTX_ID=-1
QA_REQUIRE_PHOTOMETRIC=true
QA_PHOTOMETRIC_FACE_LUMA_MIN=86
QA_PHOTOMETRIC_FACE_LUMA_MAX=205
QA_PHOTOMETRIC_BACKGROUND_FACE_DELTA_MAX=20
QA_PHOTOMETRIC_SKIN_HIGHLIGHT_RATIO_MAX=0.065
QA_PHOTOMETRIC_DRESS_CLIP_RATIO_MAX=0.16
QA_PHOTOMETRIC_FLAT_FACE_DELTA_MIN=4
QA_PHOTOMETRIC_FLAT_FACE_CONTRAST_MAX=13
QA_PHOTOMETRIC_HARSH_FACE_DELTA_MAX=72
QA_PHOTOMETRIC_COLOR_TEMP_DELTA_MAX=46
WEBHOOK_BASE_URL=http://localhost:8001
# Preview Commercial only: isolated Provider alias and its independent runtime probe secret.
PROVIDER_GRANT_ORIGIN=
PROVIDER_GRANT_PROBE_SECRET=
FRONTEND_BASE_URL=http://localhost:3000
GENERATION_ENGINE=evolink

# Hosted checkout / subscriptions
PAYMENT_PROVIDER=creem
# Set true only after the configured channel has an approved monitoring owner and evidence.
SUPPORT_EMAIL=
SUPPORT_URL=
SUPPORT_MONITORED=false
REFUND_POLICY_URL=/pages/legal/refund
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_PRODUCT_PACK_50=
CREEM_PRODUCT_PACK_120=
CREEM_PRODUCT_PACK_300=
SUBSCRIPTION_BILLING_ENABLED=false
CREEM_SUBSCRIPTION_STARTER_PRODUCT_ID=
CREEM_SUBSCRIPTION_CREATOR_PRODUCT_ID=
CREEM_SUBSCRIPTION_STUDIO_PRODUCT_ID=

# Evolink
EVOLINK_API_KEY=
EVOLINK_API_BASE_URL=https://api.evolink.ai
EVOLINK_IMAGE_MODEL=gemini-3-pro-image-preview
EVOLINK_IMAGE_QUALITY=2K
EVOLINK_IMAGE_SIZE=3:4
EVOLINK_POLL_INTERVAL=5.0
EVOLINK_POLL_TIMEOUT=720
EVOLINK_MAX_RETRIES=2
CLEANUP_SOURCE_IMAGES_ON_COMPLETE=false
CLEANUP_CRON_TOKEN=
CRON_SECRET=

# Observability
SENTRY_DSN=

# Alert push (Slack incoming webhook / Feishu bot / DingTalk bot URL)
OPS_ALERT_WEBHOOK_URL=

# Email notifications (Resend - https://resend.com)
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_FROM_NAME=AI Wedding Studio

# Vercel Edge Rate Limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Live Portrait (V1.2 add-on)
REMOTE_JOIN_ENABLED=false
LIVE_PORTRAIT_ENABLED=false
ALLOW_MEMORY_FALLBACK=false

# Security
SECRET_KEY=change-me-to-a-secure-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ADMIN_TOKEN=
RATE_LIMIT_ENABLED=false
RATE_LIMIT_DEFAULT_REQUESTS=240
RATE_LIMIT_DEFAULT_WINDOW_SECONDS=60
RATE_LIMIT_SENSITIVE_REQUESTS=40
RATE_LIMIT_SENSITIVE_WINDOW_SECONDS=60
NEW_ACCOUNT_IP_LIMIT_PER_HOUR=8
NEW_ACCOUNT_DEVICE_LIMIT_PER_HOUR=3

# Trial / free preview commercial guardrails
TRIAL_WELCOME_CREDITS=2
TRIAL_DAILY_GENERATION_LIMIT=3
TRIAL_PREVIEW_MAX_WIDTH=900
TRIAL_PREVIEW_MAX_HEIGHT=1125
TRIAL_WATERMARK_TEXT=AI WEDDING STUDIO PREVIEW

# Post-processing delivery layer
POSTPROCESS_ENABLED=true
POSTPROCESS_UPSCALE_FACTOR=2
POSTPROCESS_MAX_LONG_EDGE=2400
POSTPROCESS_JPEG_QUALITY=92
POSTPROCESS_VARIANTS=2x3,3x4,9x16
