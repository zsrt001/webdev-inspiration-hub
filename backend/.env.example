APP_NAME=AI Wedding Photo API
DEBUG=false
AUTO_CREATE_TABLES=false
CORS_ALLOW_ORIGINS=https://your-frontend-domain.com
RUNTIME_ENVIRONMENT=production
# Supplied by Vercel itself; never define VERCEL_DEPLOYMENT_ID as a project variable.
RUNTIME_BUNDLE_ID=
WORKER_IMAGE_DIGEST=
ACCEPTANCE_IDENTITY_HMAC_KEY=

# Supabase/Postgres.
# You can paste Supabase's postgresql:// URL directly; the app normalizes it to asyncpg.
# Prefer Supabase direct connection or session pooler for this async SQLAlchemy backend.
# Avoid transaction pooler with asyncpg unless you have explicitly validated prepared-statement behavior.
DATABASE_URL=postgresql://vowpic_app_runtime.your-project-ref:runtime-password@aws-0-your-region.pooler.supabase.com:5432/postgres?sslmode=require
# Separate NOBYPASSRLS login granted only the vowpic_control_writer group.
CONTROL_PLANE_DATABASE_URL=postgresql://vowpic_control_login.your-project-ref:writer-password@aws-0-your-region.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase Auth.
# The backend can verify Supabase access tokens either by JWT secret or by calling /auth/v1/user with the anon key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
# Retired bootstrap variables stay false; PostgreSQL ops_feature_flags is authoritative.
GOOGLE_AUTH_ENABLED=false
AUTHENTICATED_UPLOAD_ENABLED=false
GENERATION_ENABLED=false
CREDIT_PACK_CHECKOUT_ENABLED=false
PRIVATE_DOWNLOAD_ENABLED=false
PARTNER_INVITE_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0
TASK_EXECUTION_MODE=inline

STORAGE_PROVIDER=vercel
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1
AWS_S3_ENDPOINT=
AWS_S3_PUBLIC_URL_BASE=

BLOB_READ_WRITE_TOKEN=

LLM_PROVIDER=wenwen
JIEKOU_API_KEY=
JIEKOU_CHAT_URL=https://api.jiekou.ai/v1/chat/completions
JIEKOU_VISION_MODEL=gemini-3.1-flash
WENWEN_API_KEY=
WENWEN_CHAT_API_KEY=
WENWEN_VISION_API_KEY=
WENWEN_API_BASE_URL=https://breakout.wenwen-ai.com/v1
WENWEN_CHAT_PATH=/chat/completions
WENWEN_MODELS_PATH=/models
WENWEN_TEXT_MODEL=deepseek-v3.2
WENWEN_VISION_MODEL=gemini-3.1-pro-preview
WENWEN_IMAGE_MODEL=gemini-3-pro-image-preview
WENWEN_IMAGE_GENERATE_PATH=/images/generations
WENWEN_NATIVE_IMAGE_GENERATE_PATH_TEMPLATE=/v1beta/models/{model}:generateContent
WENWEN_TASK_PATH_TEMPLATE=/tasks/{task_id}
WENWEN_IMAGE_SIZE_SINGLE=4:5
WENWEN_IMAGE_SIZE_COUPLE=3:2
WENWEN_POLL_INTERVAL=3.0
WENWEN_POLL_TIMEOUT=240
WENWEN_MAX_RETRIES=2
EVOLINK_API_KEY=
EVOLINK_API_BASE_URL=https://api.evolink.ai
EVOLINK_IMAGE_MODEL=gemini-3-pro-image-preview
EVOLINK_IMAGE_FALLBACK_MODELS=
EVOLINK_IMAGE_QUALITY=2K
EVOLINK_IMAGE_SIZE=3:4
EVOLINK_POLL_INTERVAL=5.0
EVOLINK_POLL_TIMEOUT=720
EVOLINK_MAX_RETRIES=2

WEBHOOK_BASE_URL=
FRONTEND_BASE_URL=

PAYMENT_PROVIDER=creem
MANUAL_PAYMENT_DISPLAY_NAME=Manual Review Checkout
MANUAL_PAYMENT_INSTRUCTIONS=Submit the order reference after payment and credits will be issued after review.
MANUAL_PAYMENT_CONTACT=
SUPPORT_CONTACT_EMAIL=
SUPPORT_CONTACT_URL=
REFUND_POLICY_URL=/pages/legal/refund

CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_PRODUCT_PACK_50=
CREEM_PRODUCT_PACK_120=
CREEM_PRODUCT_PACK_300=
SUBSCRIPTION_BILLING_ENABLED=false
CREEM_SUBSCRIPTION_STARTER_PRODUCT_ID=
CREEM_SUBSCRIPTION_CREATOR_PRODUCT_ID=
CREEM_SUBSCRIPTION_STUDIO_PRODUCT_ID=

GENERATION_ENGINE=wenwen

COMFY_PROVIDER=local
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFY_CLOUD_BASE_URL=https://cloud.comfy.org
COMFY_CLOUD_API_KEY=
COMFY_CLOUD_WORKFLOW_PATH=workflows/comfyui_cloud_base_minimal.json
COMFY_CLOUD_COUPLE_WORKFLOW_PATH=workflows/comfyui_cloud_couple_minimal.json
COMFY_CLOUD_NODE_MAP={"prompt":{"id":"2","key":"text"},"negative_prompt":{"id":"3","key":"text"},"init_image_name":{"id":"4","key":"image"}}
COMFYUI_WORKFLOW_PATH=workflows/comfyui_base.json
COMFYUI_INPAINT_WORKFLOW_PATH=workflows/comfyui_couple_inpaint.json
COMFYUI_LIVE_PORTRAIT_WORKFLOW_PATH=workflows/comfyui_live_portrait.json
COMFYUI_POLL_INTERVAL=1.5
COMFYUI_POLL_TIMEOUT=300
COMFYUI_MAX_RETRIES=1
COMFYUI_REQUIRE_STORAGE_DELIVERY=true
CLEANUP_SOURCE_IMAGES_ON_COMPLETE=false
CLEANUP_CRON_TOKEN=
CRON_SECRET=

# Observability
SENTRY_DSN=

# Alert push (Slack / Feishu / DingTalk incoming webhook URL)
OPS_ALERT_WEBHOOK_URL=

# Email notifications (Resend)
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_FROM_NAME=AI Wedding Studio
REMOTE_JOIN_ENABLED=false
LIVE_PORTRAIT_ENABLED=false

GATEKEEPER_ALLOW_WITHOUT_PILLOW=false
QA_ALLOW_WITHOUT_PILLOW=false
QA_REQUIRE_VISION=true
QA_FAIL_ON_VISION_ERROR=true
ALLOW_MEMORY_FALLBACK=false

SECRET_KEY=replace_me
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ADMIN_USER_IDS=
ADMIN_OPENIDS=
ADMIN_EMAILS=
ADMIN_TOKEN=
PHONE_CRYPTO_KEY=replace_me
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_REQUESTS=240
RATE_LIMIT_DEFAULT_WINDOW_SECONDS=60
RATE_LIMIT_SENSITIVE_REQUESTS=40
RATE_LIMIT_SENSITIVE_WINDOW_SECONDS=60
NEW_ACCOUNT_IP_LIMIT_PER_HOUR=8
NEW_ACCOUNT_DEVICE_LIMIT_PER_HOUR=3

# Trial / free preview commercial guardrails.
TRIAL_WELCOME_CREDITS=6
TRIAL_DAILY_GENERATION_LIMIT=3
TRIAL_PREVIEW_MAX_WIDTH=900
TRIAL_PREVIEW_MAX_HEIGHT=1125
TRIAL_WATERMARK_TEXT=AI WEDDING STUDIO PREVIEW

# Post-processing delivery layer.
POSTPROCESS_ENABLED=true
POSTPROCESS_UPSCALE_FACTOR=2
POSTPROCESS_MAX_LONG_EDGE=2400
POSTPROCESS_JPEG_QUALITY=92
POSTPROCESS_VARIANTS=2x3,3x4,9x16
