APP_NAME=AI Wedding Photo API
DEBUG=false
AUTO_CREATE_TABLES=false
CORS_ALLOW_ORIGINS=https://your-frontend-domain.com

# Supabase/Postgres.
# You can paste Supabase's postgresql:// URL directly; the app normalizes it to asyncpg.
# Prefer Supabase direct connection or session pooler for this async SQLAlchemy backend.
# Avoid transaction pooler with asyncpg unless you have explicitly validated prepared-statement behavior.
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase Auth.
# The backend can verify Supabase access tokens either by JWT secret or by calling /auth/v1/user with the anon key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
REDIS_URL=redis://127.0.0.1:6379/0
TASK_EXECUTION_MODE=inline

STORAGE_PROVIDER=vercel
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1
AWS_S3_ENDPOINT=
AWS_S3_PUBLIC_URL_BASE=

BLOB_READ_WRITE_TOKEN=
VERCEL_BLOB_TOKEN=
VERCEL_BLOB_UPLOAD_URL_BASE=
VERCEL_BLOB_PUBLIC_URL_BASE=

LLM_PROVIDER=wenwen
JIEKOU_API_KEY=
JIEKOU_CHAT_URL=https://api.jiekou.ai/v1/chat/completions
JIEKOU_VISION_MODEL=gemini-3.1-flash
WENWEN_API_KEY=
WENWEN_CHAT_API_KEY=
WENWEN_VISION_API_KEY=
WENWEN_API_BASE_URL=https://breakout.wenwen-ai.com/v1
WENWEN_CHAT_PATH=/chat/completions
WENWEN_MODELS_PATH=/models
WENWEN_TEXT_MODEL=deepseek-v3.2
WENWEN_VISION_MODEL=gemini-3.1-pro-preview
WENWEN_IMAGE_MODEL=gemini-3-pro-image-preview
WENWEN_IMAGE_GENERATE_PATH=/images/generations
WENWEN_NATIVE_IMAGE_GENERATE_PATH_TEMPLATE=/v1beta/models/{model}:generateContent
WENWEN_TASK_PATH_TEMPLATE=/tasks/{task_id}
WENWEN_IMAGE_SIZE_SINGLE=4:5
WENWEN_IMAGE_SIZE_COUPLE=3:2
WENWEN_POLL_INTERVAL=3.0
WENWEN_POLL_TIMEOUT=240
WENWEN_MAX_RETRIES=0

WEBHOOK_BASE_URL=
FRONTEND_BASE_URL=

PAYMENT_PROVIDER=creem
MANUAL_PAYMENT_DISPLAY_NAME=Manual Review Checkout
MANUAL_PAYMENT_INSTRUCTIONS=Submit the order reference after payment and credits will be issued after review.
MANUAL_PAYMENT_CONTACT=

CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_PRODUCT_PACK_50=
CREEM_PRODUCT_PACK_120=
CREEM_PRODUCT_PACK_300=

GENERATION_ENGINE=wenwen

COMFY_PROVIDER=local
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFY_CLOUD_BASE_URL=https://cloud.comfy.org
COMFY_CLOUD_API_KEY=
COMFY_CLOUD_WORKFLOW_PATH=workflows/comfyui_cloud_base_minimal.json
COMFY_CLOUD_COUPLE_WORKFLOW_PATH=workflows/comfyui_cloud_couple_minimal.json
COMFY_CLOUD_NODE_MAP={"prompt":{"id":"2","key":"text"},"negative_prompt":{"id":"3","key":"text"},"init_image_name":{"id":"4","key":"image"}}
COMFYUI_WORKFLOW_PATH=workflows/comfyui_base.json
COMFYUI_INPAINT_WORKFLOW_PATH=workflows/comfyui_couple_inpaint.json
COMFYUI_LIVE_PORTRAIT_WORKFLOW_PATH=workflows/comfyui_live_portrait.json
COMFYUI_POLL_INTERVAL=1.5
COMFYUI_POLL_TIMEOUT=300
COMFYUI_MAX_RETRIES=1
COMFYUI_REQUIRE_STORAGE_DELIVERY=true
CLEANUP_SOURCE_IMAGES_ON_COMPLETE=false
REMOTE_JOIN_ENABLED=false
LIVE_PORTRAIT_ENABLED=false

GATEKEEPER_ALLOW_WITHOUT_PILLOW=false
QA_ALLOW_WITHOUT_PILLOW=false
QA_REQUIRE_VISION=true
ALLOW_MEMORY_FALLBACK=false

SECRET_KEY=replace_me
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ADMIN_TOKEN=replace_me
PHONE_CRYPTO_KEY=replace_me
